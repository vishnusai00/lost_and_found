<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Login</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <header class="header">
      <h1>Student Login</h1>
      <p>Login to view your claims.</p>
    </header>

    <main class="content">
      <div class="card">
        <% if (error) { %>
          <p class="meta" style="color:#dc2626; margin-bottom:8px;"><%= error %></p>
        <% } %>

        <form action="/auth/login" method="POST" class="form">
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" required>
          </div>

          <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required>
          </div>

          <button type="submit" class="btn primary full">Login</button>
          <a href="/auth/register" class="link back-link">New user? Register</a>
        </form>
      </div>
    </main>

    <footer class="footer">
      <p>Mini Project • Lost & Found Portal</p>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  