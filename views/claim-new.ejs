<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Claim Item</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <div class="brand-logo">◎</div>
          <div class="brand-text">Campus Lost &amp; Found</div>
        </a>
        <nav class="nav-links">
          <a href="/items">Browse items</a>
          <a href="/lost/new">Report lost</a>
          <a href="/found/new">Report found</a>
          <% if (currentUser) { %>
            <a href="/my/claims">My claims</a>
            <form action="/auth/logout" method="POST" class="nav-form">
              <button type="submit" class="nav-btn">Logout</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Sign up</a>
          <% } %>
          <a href="/admin/login" class="nav-admin">Admin</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="card list-card">
        <h1>Claim this item</h1>
        <p class="hero-subtitle">
          Share enough details so the finder or admin can verify it’s really yours.
        </p>

        <div class="claimed-item-summary">
          <p class="meta">
            Item:
            <strong><%= item.title %></strong>
            (<%= item.type === "lost" ? "Lost" : "Found" %>)
          </p>
          <p class="meta">
            Location: <strong><%= item.location %></strong>
          </p>
        </div>

        <form action="/items/<%= item._id %>/claim" method="POST" class="form">
          <div class="form-group">
            <label>Your name</label>
            <input type="text" name="name" placeholder="Your full name" required>
          </div>

          <div class="form-group">
            <label>Contact</label>
            <input type="text" name="contact" placeholder="Phone number or email" required>
          </div>

          <div class="form-group">
            <label>Why do you think this is your item?</label>
            <textarea
              name="message"
              rows="4"
              placeholder="Example: My name is on the card, color and brand, unique marks etc."
              required
            ></textarea>
          </div>

          <button type="submit" class="btn primary full">Submit claim</button>
          <a href="/items" class="back-link">← Back to all items</a>
        </form>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© <%= new Date().getFullYear() %> Campus Lost &amp; Found.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/items">Browse</a>
          <a href="/auth/login">Student access</a>
          <a href="/admin/login">Admin</a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  