<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Report Found Item</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <div class="brand-logo">◎</div>
          <div class="brand-text">Campus Lost &amp; Found</div>
        </a>
        <nav class="nav-links">
          <a href="/items">Browse items</a>
          <a href="/lost/new">Report lost</a>
          <a href="/found/new">Report found</a>
          <% if (currentUser) { %>
            <a href="/my/claims">My claims</a>
            <form action="/auth/logout" method="POST" class="nav-form">
              <button type="submit" class="nav-btn">Logout</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Sign up</a>
          <% } %>
          <a href="/admin/login" class="nav-admin">Admin</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="card list-card">
        <h1>Report a found item</h1>
        <p class="hero-subtitle">
          Share what you found so the right person can reach you.
        </p>

        <form action="/found" method="POST" enctype="multipart/form-data" class="form">
          <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" placeholder="e.g. Found wallet near parking" required>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="3" placeholder="What does it look like? Any special details?"></textarea>
          </div>

          <div class="form-group">
            <label>Category</label>
            <select name="category">
              <option>ID card</option>
              <option>Book</option>
              <option>Electronics</option>
              <option>Accessories</option>
              <option>Others</option>
            </select>
          </div>

          <div class="form-group">
            <label>Found at</label>
            <input type="text" name="location" placeholder="e.g. Main gate, block A stairs, auditorium">
          </div>

          <div class="form-group">
            <label>Your contact</label>
            <input type="text" name="contact" placeholder="Phone number or email">
          </div>

          <div class="form-group">
            <label>Upload image (optional)</label>
            <input type="file" name="image" accept="image/*">
          </div>

          <button type="submit" class="btn primary full">Submit found item</button>
          <a href="/items" class="back-link">← Back to all items</a>
        </form>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© <%= new Date().getFullYear() %> Campus Lost &amp; Found.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/items">Browse</a>
          <a href="/auth/login">Student access</a>
          <a href="/admin/login">Admin</a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  
