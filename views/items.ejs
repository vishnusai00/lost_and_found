<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Lost & Found Items</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <div class="brand-logo">◎</div>
          <div class="brand-text">Campus Lost &amp; Found</div>
        </a>
        <nav class="nav-links">
          <a href="/items">Browse items</a>
          <a href="/lost/new">Report lost</a>
          <a href="/found/new">Report found</a>
          <% if (currentUser) { %>
            <a href="/my/claims">My claims</a>
            <form action="/auth/logout" method="POST" class="nav-form">
              <button type="submit" class="nav-btn">Logout</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Sign up</a>
          <% } %>
          <a href="/admin/login" class="nav-admin">Admin</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="card list-card">
        <h1>All reports</h1>
        <p class="hero-subtitle">Use filters to narrow down by type, category or text.</p>

        <div class="filters">
          <form action="/items" method="GET" class="filter-form">
            <div class="filter-group">
              <label>Type</label>
              <select name="type">
                <option value="all" <%= filters.type === "all" ? "selected" : "" %>>All</option>
                <option value="lost" <%= filters.type === "lost" ? "selected" : "" %>>Lost</option>
                <option value="found" <%= filters.type === "found" ? "selected" : "" %>>Found</option>
              </select>
            </div>

            <div class="filter-group">
              <label>Category</label>
              <select name="category">
                <option value="all" <%= filters.category === "all" ? "selected" : "" %>>All</option>
                <option value="ID card" <%= filters.category === "ID card" ? "selected" : "" %>>ID card</option>
                <option value="Book" <%= filters.category === "Book" ? "selected" : "" %>>Book</option>
                <option value="Electronics" <%= filters.category === "Electronics" ? "selected" : "" %>>Electronics</option>
                <option value="Accessories" <%= filters.category === "Accessories" ? "selected" : "" %>>Accessories</option>
                <option value="Others" <%= filters.category === "Others" ? "selected" : "" %>>Others</option>
              </select>
            </div>

            <div class="filter-group">
              <label>Search</label>
              <input
                type="text"
                name="q"
                placeholder="Search title, description, location"
                value="<%= filters.q %>"
              >
            </div>

            <button type="submit" class="btn primary">Apply filters</button>
            <a href="/items" class="btn secondary">Clear</a>
          </form>
        </div>

        <% if (items.length === 0) { %>
          <p>No items reported yet.</p>
        <% } else { %>
          <ul class="item-list">
            <% items.forEach(item => { %>
              <li class="item">
                <span class="badge <%= item.type === 'lost' ? 'lost' : 'found' %>">
                  <%= item.type === 'lost' ? 'Lost' : 'Found' %>
                </span>
                <h3><%= item.title %></h3>

                <% if (item.imageUrl) { %>
                  <div class="item-image">
                    <img src="<%= item.imageUrl %>" alt="Item image">
                  </div>
                <% } %>

                <p class="meta">
                  Status:
                  <strong><%= item.status === "resolved" ? "Resolved / Returned" : "Open" %></strong>
                </p>

                <p class="desc"><%= item.description %></p>
                <p class="meta">Category: <strong><%= item.category %></strong></p>
                <p class="meta">Location: <strong><%= item.location %></strong></p>
                <p class="meta">Contact: <strong><%= item.contact %></strong></p>

                <% if (item.status !== "resolved") { %>
                  <div class="claim-actions">
                    <a href="/items/<%= item._id %>/claim" class="btn secondary">Claim this item</a>
                  </div>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>

        <div class="list-actions">
          <a href="/lost/new" class="btn primary">Report lost item</a>
          <a href="/found/new" class="btn secondary">Report found item</a>
          <a href="/" class="link back-link">← Back to home</a>
        </div>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© <%= new Date().getFullYear() %> Campus Lost &amp; Found.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/auth/login">Student access</a>
          <a href="/admin/login">Admin</a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  
