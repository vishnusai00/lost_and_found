<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Campus Lost & Found</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <div class="brand-logo">◎</div>
          <div class="brand-text">Campus Lost &amp; Found</div>
        </a>
        <nav class="nav-links">
          <a href="/items">Browse items</a>
          <a href="/lost/new">Report lost</a>
          <a href="/found/new">Report found</a>
          <% if (currentUser) { %>
            <a href="/my/claims">My claims</a>
            <form action="/auth/logout" method="POST" class="nav-form">
              <button type="submit" class="nav-btn">Logout</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Sign up</a>
          <% } %>
          <a href="/admin/login" class="nav-admin">Admin</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="hero-layout">
        <section>
          <div class="card">
            <p class="hero-eyebrow">Campus utility</p>
            <h1>Find what’s lost. Return what’s found.</h1>
            <p class="hero-subtitle">
              A simple space where students can report lost or found items, attach photos,
              and connect with the right person quickly.
            </p>

            <div class="quick-actions">
              <div class="quick-actions-row">
                <a href="/lost/new" class="btn primary">Report lost item</a>
                <a href="/found/new" class="btn secondary">Report found item</a>
              </div>
              <div class="quick-actions-row">
                <a href="/items" class="btn secondary">Browse all reports</a>
              </div>

              <% if (currentUser) { %>
                <p class="meta" style="margin-top:6px;">
                  Logged in as <strong><%= currentUser.name %></strong>. 
                  <a href="/my/claims" class="link">View your claims</a>
                </p>
              <% } else { %>
                <p class="meta" style="margin-top:6px;">
                  Want to track your claims? 
                  <a href="/auth/register" class="link">Create an account</a>.
                </p>
              <% } %>
            </div>
          </div>
        </section>

        <section>
          <div class="card">
            <h2 class="section-title">How it works</h2>
            <ul class="item-list">
              <li class="item">
                <h3>1. Post a lost or found item</h3>
                <p class="desc">
                  Share a short description, location, and a quick contact. You can also attach a photo.
                </p>
              </li>
              <li class="item">
                <h3>2. Browse reports on campus</h3>
                <p class="desc">
                  Use filters and search to quickly scan through lost and found items.
                </p>
              </li>
              <li class="item">
                <h3>3. Submit a claim</h3>
                <p class="desc">
                  If you recognise an item, submit a claim with details only you would know.
                </p>
              </li>
              <li class="item">
                <h3>4. Admin verifies & marks resolved</h3>
                <p class="desc">
                  Admin reviews claims, approves the correct one, and marks the item as returned.
                </p>
              </li>
            </ul>
          </div>
        </section>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© <%= new Date().getFullYear() %> Campus Lost &amp; Found.</span>
        <div class="footer-links">
          <a href="/items">Browse</a>
          <a href="/lost/new">Report</a>
          <a href="/auth/login">Student access</a>
          <a href="/admin/login">Admin</a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  