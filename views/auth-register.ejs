<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student Sign Up</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="topbar-inner">
        <a href="/" class="brand">
          <div class="brand-logo">◎</div>
          <div class="brand-text">Campus Lost &amp; Found</div>
        </a>
        <nav class="nav-links">
          <a href="/items">Browse items</a>
          <a href="/lost/new">Report lost</a>
          <a href="/found/new">Report found</a>
          <% if (currentUser) { %>
            <a href="/my/claims">My claims</a>
            <form action="/auth/logout" method="POST" class="nav-form">
              <button type="submit" class="nav-btn">Logout</button>
            </form>
          <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Sign up</a>
          <% } %>
          <a href="/admin/login" class="nav-admin">Admin</a>
        </nav>
      </div>
    </header>

    <main class="main">
      <div class="card list-card">
        <h1>Create your account</h1>
        <p class="hero-subtitle">
          Save your details and easily track all the claims you submit.
        </p>

        <% if (error) { %>
          <p class="meta" style="color:#f97373; margin-bottom:8px;"><%= error %></p>
        <% } %>

        <form action="/auth/register" method="POST" class="form">
          <div class="form-group">
            <label>Name</label>
            <input type="text" name="name" placeholder="Your full name" required>
          </div>

          <div class="form-group">
            <label>College email</label>
            <input type="email" name="email" placeholder="you@college.edu" required>
          </div>

          <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Create a password" required>
          </div>

          <button type="submit" class="btn primary full">Create account</button>
          <a href="/auth/login" class="back-link">Already have an account? Login</a>
        </form>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>© <%= new Date().getFullYear() %> Campus Lost &amp; Found.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/items">Browse</a>
          <a href="/admin/login">Admin</a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    window.VAPID_PUBLIC_KEY = "<%= typeof VAPID_PUBLIC_KEY !== 'undefined' ? VAPID_PUBLIC_KEY : '' %>";
    window.CURRENT_USER_LOGGED_IN = <%= typeof USER_LOGGED_IN !== 'undefined' && USER_LOGGED_IN ? 1 : 0 %>;
  </script>
  <script src="/js/push.js"></script>
  </body>
  </html>
  